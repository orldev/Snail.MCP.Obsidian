<Project Sdk="Snail.Sdk.Mcp">

    <!--
        A native stdio server (Snail.Sdk.Mcp: SnailMcpNative and SnailMcpTransport at their defaults): published with
        Native AOT, a native dotnet tool package for each platform with a framework-dependent one for the rest. The
        vault is files only, so Windows is among them.
    -->

    <PropertyGroup>
        <PackageVersion>0.1.0</PackageVersion>
        <PackageTags>AI; MCP; server; stdio; obsidian; excalidraw</PackageTags>
        <Description>MCP server bridging AI agents and an Obsidian vault: semantic reading and safe drawing of Excalidraw schemes.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol"/>
    </ItemGroup>

</Project>
